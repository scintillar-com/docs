# Dependencies
node_modules

# Build
dist

# Next.js dev cache
packages/*/src/next-app/.next

# Fixture build output (fixtures/<name>/out from `registry-shell build`,
# plus its own Next cache when using `dev`).
fixtures/*/out
fixtures/*/.next

# Files the shell CLI rewrites every boot
packages/*/src/next-app/.*-mode
packages/*/src/next-app/app/_user-sources.css
packages/*/src/next-app/app/_user-global.css

# TypeScript cache
*.tsbuildinfo

# Test output
test-results
playwright-report
coverage
.eslintcache

# npm pack output
*.tgz

# Environment secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea
