# Dependencies
node_modules

# Build
dist

# Next.js dev cache
packages/*/src/next-app/.next

# Fixture build output (fixtures/<name>/out from `registry-shell build`,
# plus its own Next cache when using `dev`).
fixtures/*/out
fixtures/*/.next

# Files the shell CLI rewrites every boot
packages/*/src/next-app/.*-mode
packages/*/src/next-app/app/_user-sources.css
packages/*/src/next-app/app/_user-global.css
packages/*/src/next-app/.registry-shell-public.json
# The shell's public/ only holds its favicons; the rest is the search index
# and a site's public/ overlaid during a build (left over when a dev server
# is stopped mid-run).
packages/*/src/next-app/public/*
!packages/*/src/next-app/public/favicon.ico
!packages/*/src/next-app/public/favicon_dark.svg
!packages/*/src/next-app/public/favicon_light.svg

# TypeScript cache
*.tsbuildinfo

# Test output
test-results
playwright-report
coverage
.eslintcache

# npm pack output
*.tgz

# Environment secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea

# Generated by packages/registry-shell/scripts/gen-shell-stubs.mjs on prepack
packages/registry-shell/shell
