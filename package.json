{
  "name": "registry-shell-monorepo",
  "private": true,
  "description": "Workspace root for @sntlr/registry-shell (packages/registry-shell) and its test fixtures (fixtures/*).",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "pnpm --filter @sntlr/registry-shell build",
    "lint": "pnpm --filter @sntlr/registry-shell lint",
    "typecheck": "pnpm --filter @sntlr/registry-shell typecheck",
    "test": "pnpm --filter @sntlr/registry-shell test",
    "test:theme-panel": "pnpm --filter @sntlr/registry-shell test:theme-panel",
    "test:docs": "pnpm --filter @sntlr/registry-shell test:docs",
    "test:fixtures": "node scripts/check-fixture-routes.mjs",
    "dev:registry": "pnpm --filter dev-registry shell",
    "release": "node scripts/release.mjs"
  }
}
