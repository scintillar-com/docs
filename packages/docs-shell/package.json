{
  "name": "@sntlr/docs-shell",
  "version": "2.8.1",
  "description": "Static documentation sites with versioned docs, i18n, search and a theme panel, from a folder of MDX. Optional component-registry module (see @sntlr/registry-shell).",
  "keywords": [
    "docs",
    "documentation",
    "mdx",
    "static-site",
    "versioned-docs",
    "next",
    "nextjs",
    "shell",
    "shadcn",
    "registry"
  ],
  "license": "MIT",
  "author": "Scintillar",
  "homepage": "https://github.com/scintillar-com/registry-shell/tree/main/packages/docs-shell#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scintillar-com/registry-shell.git",
    "directory": "packages/docs-shell"
  },
  "bugs": {
    "url": "https://github.com/scintillar-com/registry-shell/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "docs-shell": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli/index.js",
    "./content": {
      "types": "./dist/content/index.d.ts",
      "default": "./dist/content/index.js"
    },
    "./shell/*": "./src/next-app/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/adapter",
    "dist/cli",
    "dist/content",
    "dist/config-loader.js",
    "dist/config-loader.d.ts",
    "dist/define-config.js",
    "dist/define-config.d.ts",
    "dist/index.js",
    "dist/index.d.ts",
    "src/adapter",
    "src/cli",
    "src/content",
    "src/config-loader.ts",
    "src/define-config.ts",
    "src/index.ts",
    "src/next-app/app",
    "src/next-app/components",
    "src/next-app/fallback",
    "src/next-app/fonts",
    "src/next-app/hooks",
    "src/next-app/lib",
    "src/next-app/public/favicon.ico",
    "src/next-app/public/favicon_dark.svg",
    "src/next-app/public/favicon_light.svg",
    "src/next-app/next.config.ts",
    "src/next-app/next-env.d.ts",
    "src/next-app/postcss.config.mjs",
    "src/next-app/registry.config.ts",
    "src/next-app/shell.config.ts",
    "src/next-app/tsconfig.json",
    "src/next-app/user-aliases.d.ts",
    "!src/**/*.test.ts",
    "!src/next-app/app/_user-sources.css",
    "!src/next-app/app/_user-global.css",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:shell": "node dist/cli/index.js dev",
    "dev:registry": "pnpm --filter dev-registry shell",
    "build": "tsc -p tsconfig.cli.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "prepack": "tsc -p tsconfig.cli.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:theme-panel": "pnpm build && playwright test -c playwright.theme-panel.config.ts",
    "test:docs": "pnpm build && playwright test -c playwright.docs.config.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gray-matter": "^4.0.3",
    "jiti": "^2.4.2",
    "lucide-react": "^0.503.0",
    "next": "^15.5.14",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.59.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.15",
    "eslint-plugin-react-hooks": "^7.0.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.3"
  }
}
