{
  "name": "@sntlr/registry-shell",
  "version": "2.8.1",
  "description": "Generic Next.js viewer for component registries. Drop a registry-shell.config.ts into your registry and get a full docs/components/blocks site. A preset of @sntlr/docs-shell with the registry module.",
  "keywords": [
    "shadcn",
    "registry",
    "components",
    "ui",
    "next",
    "nextjs",
    "docs",
    "shell"
  ],
  "license": "MIT",
  "author": "Scintillar",
  "homepage": "https://github.com/scintillar-com/docs/tree/main/packages/registry-shell#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scintillar-com/docs.git",
    "directory": "packages/registry-shell"
  },
  "bugs": {
    "url": "https://github.com/scintillar-com/docs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "registry-shell": "./bin/registry-shell.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./shell/*": "./shell/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "index.js",
    "index.d.ts",
    "shell",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "prepack": "node scripts/gen-shell-stubs.mjs"
  },
  "dependencies": {
    "@sntlr/docs-shell": "2.8.1"
  }
}
